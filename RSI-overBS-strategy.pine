//@version=6
strategy(
     title = "RSI Momentum Breakout Strategy",
     shorttitle = "RSI Momentum",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10
)

//------------------------------------------------------------------------------
// Inputs
//------------------------------------------------------------------------------

GRP_RSI = "RSI Settings"
rsiLengthInput = input.int(14, minval = 1, title = "RSI Length", group = GRP_RSI)
rsiSourceInput = input.source(close, title = "Source", group = GRP_RSI)
enableRsiJumpFilter = input.bool(
     true,
     title = "Enable RSI Jump Filter",
     group = GRP_RSI
 )
maxRsiChangeMultiplier = input.float(
     2.0,
     title = "Maximum RSI Change Multiplier",
     minval = 1.0,
     step = 0.1,
     group = GRP_RSI
 )

GRP_FILTERS = "Candle Entry Filters"
enableBodyFilter = input.bool(
     false,
     title = "Enable Body Size Filter",
     group = GRP_FILTERS
 )
maxBodyMultiplier = input.float(
     2.0,
     title = "Maximum Body Size Multiplier",
     minval = 1.0,
     step = 0.1,
     group = GRP_FILTERS
 )
enableWickFilter = input.bool(
     false,
     title = "Enable Directional Wick Filter",
     group = GRP_FILTERS
 )
maxWickMultiplier = input.float(
     2.0,
     title = "Maximum Wick Size Multiplier",
     minval = 1.0,
     step = 0.1,
     group = GRP_FILTERS
 )

GRP_STRAT = "Strategy Levels"
longCrossLevel  = input.float(70.0, title = "Long Trigger Level (Break Above)", minval = 0.0, maxval = 100.0, step = 0.5, group = GRP_STRAT)
longPrepLevel   = input.float(60.0, title = "Long Origin Level (Was Below)", minval = 0.0, maxval = 100.0, step = 0.5, group = GRP_STRAT)

shortCrossLevel = input.float(30.0, title = "Short Trigger Level (Break Below)", minval = 0.0, maxval = 100.0, step = 0.5, group = GRP_STRAT)
shortPrepLevel  = input.float(40.0, title = "Short Origin Level (Was Above)", minval = 0.0, maxval = 100.0, step = 0.5, group = GRP_STRAT)

riskReward = input.float(2.0, title = "Risk / Reward Ratio", minval = 0.1, step = 0.1, group = GRP_STRAT)

GRP_BE = "Break-Even Settings"
enableBreakEven = input.bool(false, title = "Enable Break Even", group = GRP_BE)
beOffsetTicks = input.int(0, title = "Break-Even Offset (Ticks)", minval = 0, group = GRP_BE)
enableTrailingSlAfterTp = input.bool(
     false,
     title = "Trail Stop Two Bars Behind After New TP",
     group = GRP_BE
 )

//------------------------------------------------------------------------------
// RSI Calculation
//------------------------------------------------------------------------------

change = ta.change(rsiSourceInput)
up = ta.rma(math.max(change, 0), rsiLengthInput)
down = ta.rma(-math.min(change, 0), rsiLengthInput)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

// The trigger bar is excluded from the 14-bar RSI change average.
rsiChange = math.abs(rsi - rsi[1])
avgRsiChange = ta.sma(rsiChange[1], 14)
rsiChangeAllowed = not enableRsiJumpFilter or (
     not na(avgRsiChange) and
     rsiChange <= avgRsiChange * maxRsiChangeMultiplier
 )

//------------------------------------------------------------------------------
// Candle Entry Filters
//------------------------------------------------------------------------------

// Compare the trigger bar's body with the previous 14 candle bodies.
bodySize = math.abs(close - open)
avgBodySize = ta.sma(bodySize[1], 14)
bodyAllowed = not enableBodyFilter or (
     not na(avgBodySize) and
     (bodySize == 0 or bodySize < avgBodySize * maxBodyMultiplier)
 )

// Long: upper wick vs. prior upper wicks.
// Short: lower wick vs. prior lower wicks.
upperWickSize = high - math.max(open, close)
lowerWickSize = math.min(open, close) - low

avgUpperWickSize = ta.sma(upperWickSize[1], 14)
avgLowerWickSize = ta.sma(lowerWickSize[1], 14)

longWickAllowed = not enableWickFilter or (
     not na(avgUpperWickSize) and
     (upperWickSize == 0 or upperWickSize < avgUpperWickSize * maxWickMultiplier)
 )

shortWickAllowed = not enableWickFilter or (
     not na(avgLowerWickSize) and
     (lowerWickSize == 0 or lowerWickSize < avgLowerWickSize * maxWickMultiplier)
 )

//------------------------------------------------------------------------------
// State Tracking
//------------------------------------------------------------------------------

var bool primedForLong = false
var bool primedForShort = false

if rsi <= longPrepLevel
    primedForLong := true

if rsi >= shortPrepLevel
    primedForShort := true

longCond = primedForLong and ta.crossover(rsi, longCrossLevel)
shortCond = primedForShort and ta.crossunder(rsi, shortCrossLevel)

if longCond
    primedForLong := false

if shortCond
    primedForShort := false

//------------------------------------------------------------------------------
// Trade Variables
//------------------------------------------------------------------------------

var float activeStopLoss = na
var float activeTakeProfit = na
var bool breakEvenActive = false

if strategy.position_size == 0
    activeStopLoss := na
    activeTakeProfit := na
    breakEvenActive := false

canTrade = strategy.position_size == 0
beOffset = beOffsetTicks * syminfo.mintick

//------------------------------------------------------------------------------
// Entries
//------------------------------------------------------------------------------

// Long entry
if barstate.isconfirmed and canTrade and longCond and rsiChangeAllowed and bodyAllowed and longWickAllowed
    slPrice = low[1]
    riskDistance = close - slPrice

    if not na(slPrice) and riskDistance > 0
        activeStopLoss := slPrice
        activeTakeProfit := close + (riskDistance * riskReward)
        breakEvenActive := false
        strategy.entry("Long", strategy.long)

        // Protect the position with a stop-only order when BE is enabled.
        if enableBreakEven
            strategy.exit("Long Exit", from_entry = "Long", stop = activeStopLoss)

// Short entry
if barstate.isconfirmed and canTrade and shortCond and rsiChangeAllowed and bodyAllowed and shortWickAllowed
    slPrice = high[1]
    riskDistance = slPrice - close

    if not na(slPrice) and riskDistance > 0
        activeStopLoss := slPrice
        activeTakeProfit := close - (riskDistance * riskReward)
        breakEvenActive := false
        strategy.entry("Short", strategy.short)

        if enableBreakEven
            strategy.exit("Short Exit", from_entry = "Short", stop = activeStopLoss)

//------------------------------------------------------------------------------
// Long Exit Management
//------------------------------------------------------------------------------

if strategy.position_size > 0
    if enableBreakEven
        bool closeAtInitialTarget = false
        bool newTargetSetThisBar = false

        // First touch of the original TP: decide using confirmed RSI.
        if not breakEvenActive and high >= activeTakeProfit
            if rsi > longCrossLevel and rsi > rsi[1]
                breakEvenActive := true
                activeStopLoss := math.max(
                     activeStopLoss,
                     strategy.position_avg_price + beOffset
                 )
                activeTakeProfit := na
            else
                closeAtInitialTarget := true
                strategy.close("Long", comment = "Initial TP - RSI not confirmed")

        // On the first RSI decline, set TP to this bar's high
        // and initially set SL to the previous bar's low.
        if breakEvenActive and na(activeTakeProfit) and rsi < rsi[1]
            activeTakeProfit := high
            activeStopLoss := low[1]
            newTargetSetThisBar := true

        // Starting on the next bar, trail SL two bars behind.
        // Never lower the stop once trailing has begun.
        if enableTrailingSlAfterTp and
             not newTargetSetThisBar and
             breakEvenActive and
             not na(activeTakeProfit) and
             not na(low[2])
            activeStopLoss := math.max(activeStopLoss, low[2])

        if not closeAtInitialTarget
            strategy.exit(
                 "Long Exit",
                 from_entry = "Long",
                 stop = activeStopLoss,
                 limit = breakEvenActive ? activeTakeProfit : na
             )
    else
        strategy.exit(
             "Long Exit",
             from_entry = "Long",
             stop = activeStopLoss,
             limit = activeTakeProfit
         )

//------------------------------------------------------------------------------
// Short Exit Management
//------------------------------------------------------------------------------

if strategy.position_size < 0
    if enableBreakEven
        bool closeAtInitialTarget = false
        bool newTargetSetThisBar = false

        // First touch of the original TP: decide using confirmed RSI.
        if not breakEvenActive and low <= activeTakeProfit
            if rsi < shortCrossLevel and rsi < rsi[1]
                breakEvenActive := true
                activeStopLoss := math.min(
                     activeStopLoss,
                     strategy.position_avg_price - beOffset
                 )
                activeTakeProfit := na
            else
                closeAtInitialTarget := true
                strategy.close("Short", comment = "Initial TP - RSI not confirmed")

        // On the first RSI increase, set TP to this bar's low
        // and initially set SL to the previous bar's high.
        if breakEvenActive and na(activeTakeProfit) and rsi > rsi[1]
            activeTakeProfit := low
            activeStopLoss := high[1]
            newTargetSetThisBar := true

        // Starting on the next bar, trail SL two bars behind.
        // Never raise the stop once trailing has begun.
        if enableTrailingSlAfterTp and
             not newTargetSetThisBar and
             breakEvenActive and
             not na(activeTakeProfit) and
             not na(high[2])
            activeStopLoss := math.min(activeStopLoss, high[2])

        if not closeAtInitialTarget
            strategy.exit(
                 "Short Exit",
                 from_entry = "Short",
                 stop = activeStopLoss,
                 limit = breakEvenActive ? activeTakeProfit : na
             )
    else
        strategy.exit(
             "Short Exit",
             from_entry = "Short",
             stop = activeStopLoss,
             limit = activeTakeProfit
         )

//------------------------------------------------------------------------------
// Plots
//------------------------------------------------------------------------------

plot(
     strategy.position_size != 0 ? activeStopLoss : na,
     title = "Stop Loss",
     color = color.red,
     linewidth = 2,
     style = plot.style_linebr
 )

plot(
     strategy.position_size != 0 ? activeTakeProfit : na,
     title = "Take Profit",
     color = color.green,
     linewidth = 2,
     style = plot.style_linebr
 )